# ── Calendar (required) ───────────────────────────────────────────────
# Outlook: Settings → Calendar → Shared calendars → Publish → ICS link.
# Treat this URL like a password: anyone with it can read your calendar.
ICS_URL=https://outlook.office365.com/owa/calendar/.../calendar.ics

# Additional calendars (comma-separated, optional)
# ICS_URLS_EXTRA=https://example.com/personal.ics,https://example.com/shared.ics

# Timezone (IANA format, e.g. America/New_York, Europe/London)
TIMEZONE=America/Los_Angeles

# ── Display personalization (optional) ───────────────────────────────
# USER_NAME=Jane Doe                 # Shows "👋 Hi, I'm Jane"
# ROOM_NUMBER=Building 4 / 1234      # Shows "You're in Building 4 / 1234"
# OOO_KEYWORD=jdoe ooo               # Events starting with this count as out-of-office
# LOGO_FILE=custom/logo.png          # Optional corner logo under static/ (put personal files in static/custom/)
# QR_FILE=custom/qr.png              # Custom QR image under static/; otherwise generated from PUBLIC_URL.
#                                    # Without a logo, the QR shows in the corner all the time.
# EASTER_EGG_MESSAGE=👋 Thanks for stopping by!

# ── Schedule (optional) ──────────────────────────────────────────────
# BUSINESS_START_HOUR=8              # Display sleeps outside these hours (Mon–Fri)
# BUSINESS_END_HOUR=18
# OFFICE_DAYS=Tue,Wed,Thu            # Default location is "office" on these days...
# OFFICE_HOURS=10-15                 # ...between these hours (24h), "remote" otherwise

# ── Server ───────────────────────────────────────────────────────────
# HOST=127.0.0.1                     # Keep on localhost; cloudflared connects locally
# PORT=5001
# TRUSTED_NETWORKS=192.168.1.0/24    # Optional: treat these source IPs like localhost (full access, by IP only)

# ── Remote access via Cloudflare Tunnel + Access (optional) ─────────
# Without these, only localhost can use the app. See README → Security.
# PUBLIC_URL=https://desk.example.com
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=aud-tag-of-admin-app,aud-tag-of-msg-app   # Access app "Application Audience (AUD) Tag"(s)
# OWNER_EMAILS=you@example.com                            # Full admin access
# OWNER_SERVICE_TOKENS=abc123.access                      # Service-token Client IDs with full access (iOS Shortcuts)
# PUBLIC_DISPLAY=false                                    # true = status page viewable without login
